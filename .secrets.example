# Template. Copy it and fill it in:
#
#     cp .secrets.example .secrets && chmod 600 .secrets
#
# .secrets is in .gitignore and must never reach the repository.
# This template is safe to commit: it holds no values.
#
# Loaded by anthropic-env.sh:
#     source ./anthropic-env.sh on

export ANTHROPIC_AUTH_TOKEN="your-gateway-token-here"
export ANTHROPIC_BASE_URL="https://your-gateway/"
