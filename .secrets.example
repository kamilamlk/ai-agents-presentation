# Образец. Скопировать и заполнить:
#
#     cp .secrets.example .secrets && chmod 600 .secrets
#
# .secrets лежит в .gitignore и не должен попадать в репозиторий никогда.
# Этот файл-образец коммитить можно: в нём нет значений.
#
# Подключается скриптом anthropic-env.sh:
#     source ./anthropic-env.sh on

export ANTHROPIC_AUTH_TOKEN="токен-шлюза-сюда"
export ANTHROPIC_BASE_URL="https://адрес-шлюза/"
